/*
 * WiFi credentials -- copy this file to secrets.h and edit it.
 *
 *     cp secrets.h.example secrets.h        (PowerShell: Copy-Item)
 *
 * secrets.h is git-ignored so the demo network password never lands in the
 * repository.
 *
 * Two ways to run (chosen with WIFI_MODE_AP in config.h):
 *
 *   WIFI_MODE_AP 1  (default, recommended for the demo)
 *       The ESP32 creates its own network. Join it from the laptop; the
 *       vehicle is always at 192.168.4.1, so config.json never changes and
 *       venue WiFi cannot break the demo. The password must be at least
 *       8 characters or softAP() silently refuses to start.
 *
 *   WIFI_MODE_AP 0
 *       The ESP32 joins an existing network (a phone hotspot works well).
 *       Read the IP address it prints at boot and put that into
 *       python_bridge/config.json as transport.udp.esp32_ip.
 */

#ifndef NEURODRIVE_SECRETS_H
#define NEURODRIVE_SECRETS_H

#define WIFI_SSID "NeuroDrive"
#define WIFI_PASSWORD "neurodrive2024"

#endif  // NEURODRIVE_SECRETS_H
